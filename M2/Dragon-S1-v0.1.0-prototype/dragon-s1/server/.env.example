# Server
DRAGON_SECRET_KEY=change-this-to-a-long-random-value
DRAGON_DATABASE_URL=sqlite:///./dragon_s1.db
DRAGON_ADMIN_USERNAME=admin
DRAGON_ADMIN_PASSWORD=your-password
DRAGON_ENROLLMENT_KEY=your-enrollment-key
DRAGON_TOKEN_EXPIRE_MINUTES=480
DRAGON_FACE_MATCH_MODE=auto
DRAGON_UPLOAD_RETENTION_DAYS=15
DRAGON_MAX_UPLOAD_MB=8
DRAGON_CORS_ORIGINS=*

# Advanced Production Settings
DRAGON_RATE_LIMIT_PER_MINUTE=100
DRAGON_MAX_LOGIN_ATTEMPTS=5
DRAGON_SMTP_HOST=smtp.gmail.com
DRAGON_SMTP_PORT=587
DRAGON_SMTP_USER=
DRAGON_SMTP_PASSWORD=

# Agent
DRAGON_SERVER_URL=http://127.0.0.1:8000
DRAGON_DEVICE_UID=
DRAGON_ENROLLMENT_KEY=your-enrollment-key
DRAGON_HARDWARE_USB_CONTROL=false
DRAGON_CAMERA_INDEX=0
DRAGON_AGENT_DEMO_MODE=true
PORT=3001
ENROLLMENT_KEY=your-enrollment-key
DATABASE_URL=sqlite:///./dragon_s1.db

